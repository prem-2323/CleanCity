{
  "expo": {
    "name": "CleanMap",
    "slug": "cleanmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleanmap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleanmap",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CleanMap needs your location to show nearby waste reports and enable real-time tracking for cleaners."
      }
    },
    "android": {
      "package": "com.cleanmap",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyClRYCfkZNAMFg6mrpeeJ0UotwkLy50kQY"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CleanMap needs your location to show nearby waste reports and track cleanup progress."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
